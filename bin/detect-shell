#!/bin/sh
# detect-shell - what the "Object detection" desktop launcher opens.
#
# A terminal that has already told you what to type, sitting in the directory
# where your images are. Kept separate from a long Exec= line in the .desktop
# file, where the quoting is unreadable and the shell is not the one you think.
cd "${HOME:-/tmp}" 2>/dev/null || true

detect --help || true
echo
echo "You are in: $(pwd)"
echo
detect 2>/dev/null | tail -n +1 | sed -n '/^Images in/,$p' || true
echo
echo "Try:  detect --open <image>"
echo

exec bash -i
