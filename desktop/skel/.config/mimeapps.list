# Point every image type at the viewer this image ships, by OUR desktop id
# rather than the upstream one. XFCE renamed ristretto's desktop file to a
# reverse-DNS id at some point; osp-image-viewer.desktop is ours and will not
# be renamed underneath us.

[Default Applications]
inode/directory=osp-files.desktop
image/jpeg=osp-image-viewer.desktop
image/png=osp-image-viewer.desktop
image/gif=osp-image-viewer.desktop
image/bmp=osp-image-viewer.desktop
image/webp=osp-image-viewer.desktop
image/tiff=osp-image-viewer.desktop
image/x-portable-pixmap=osp-image-viewer.desktop

[Added Associations]
image/jpeg=osp-image-viewer.desktop;
image/png=osp-image-viewer.desktop;
