[Desktop Entry]
Type=Application
Version=1.0
Name=Image Viewer
GenericName=Image Viewer
Comment=Open an image; arrow keys flip through the rest of the folder
Exec=ristretto %F
Icon=image-x-generic
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;Viewer;
MimeType=image/jpeg;image/png;image/gif;image/bmp;image/webp;image/tiff;
StartupNotify=true
