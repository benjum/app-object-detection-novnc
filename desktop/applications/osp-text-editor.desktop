[Desktop Entry]
Type=Application
Version=1.0
Name=Text Editor
GenericName=Text Editor
Comment=Read detections.json, the README, or any other text file
Exec=mousepad --disable-server %F
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;application/json;text/markdown;text/csv;text/xml;application/xml;application/x-yaml;text/x-python;text/x-shellscript;
StartupNotify=true
